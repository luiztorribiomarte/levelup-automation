# Copy to .env and fill in. NEVER commit .env.
# Token Meta gives you when you subscribe the webhook (you invent this string).
WEBHOOK_VERIFY_TOKEN=pick-a-long-random-string

# Page access token from your Facebook App (Meta Developer dashboard).
# Must have instagram_manage_comments + instagram_manage_messages.
PAGE_ACCESS_TOKEN=

# Port the server listens on (Render/Railway set PORT for you).
PORT=3000
